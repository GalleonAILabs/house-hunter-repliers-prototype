# Which adapter backs the property list: sheet (the family's Google Sheet) or
# repliers (the paid feed, not licensed for Canadian data yet). Switching to
# repliers retires the sheet importer by config alone, with no code change.
DATA_SOURCE=sheet
# Google Sheet import. Read through the sheet's public CSV export, so the sheet
# has to stay link-viewable; no OAuth client or service-account key is needed.
# SHEET_PROPERTIES_GID is the Properties tab.
SHEET_ID=1lr57peXyWrQ0AsCVY0e1Ir8jtd39UccPeEY9QTeayLk
SHEET_PROPERTIES_GID=1790810273
# Scheduled pull times, as hours in SYNC_TIMEZONE. The LaunchAgent wakes hourly
# and imports only at these hours, so the schedule stays correct even if the
# Mac's own timezone changes. See scripts/install_sync_agent.sh.
SYNC_HOURS=6,10,14,18
SYNC_TIMEZONE=America/Toronto
REPLIERS_API_KEY=your_repliers_api_key_here
REPLIERS_BASE_URL=https://api.repliers.io
PORT=8787
# Shared-secret deterrent for /api/people and /api/feedback (D3/D11).
# Not real access control, just blocks casual drive-by reads/writes over
# the public tunnel URL. Sent as the X-App-Token request header.
APP_AUTH_TOKEN=change_me_to_a_random_string
# Public Mapbox token (served to the browser via /api/config, restricted by URL
# on the Mapbox account, not by secrecy).
MAPBOX_TOKEN=your_mapbox_public_token_here
# In-app issue reporter (GAL-42). Both are server-side only and never reach the
# browser. LINEAR_API_KEY is a Linear personal API key: when set, the Report
# button appears and reports file into team GAL Triage. ANTHROPIC_API_KEY turns
# on the AI first-pass (title, type label, duplicate hint); create a NEW console
# key for this project (per-project billing). LINEAR_TEAM_KEY defaults to GAL.
LINEAR_API_KEY=
ANTHROPIC_API_KEY=
LINEAR_TEAM_KEY=GAL
# Project a tester-chosen milestone (Alpha/V1/V2) resolves against.
LINEAR_PROJECT_NAME=House Hunter - Alpha
